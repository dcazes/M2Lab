# Root .env.example - template for Homelab secrets
# Copy to .env and fill in values. Keep this file out of version control.
# See each service's .env.example for non-secret configuration.

# SurfSense
DB_PASSWORD=change_me
SEARXNG_SECRET=change_me
OPENSANDBOX_API_KEY=change_me
ZERO_ADMIN_PASSWORD=change_me

# Vaultwarden
ADMIN_TOKEN=change_me

# Paperless-ngx
PAPERLESS_SECRET_KEY=change_me
PAPERLESS_DBPASSWORD=change_me

# Nextcloud
NEXTCLOUD_DBPASSWORD=change_me

# Adventurelog
POSTGRES_PASSWORD=change_me

# Puppygraph
PUPPYGRAPH_USERNAME=change_me
PUPPYGRAPH_PASSWORD=change_me

# FreeLLMAPI
ENCRYPTION_KEY=change_me

# (Add other services as needed)