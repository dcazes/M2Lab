# Root .env.example - template for Homelab secrets
# Copy to .env and fill in values. Keep this file out of version control.
# See each service's .env.example for non-secret configuration.

# CTL_TOKEN=<openssl rand -hex 32>
# Caddy adds this only after Authentik has authenticated the browser. Use the
# same generated value in ingress/.env; it is never sent to the frontend.
OMNILAB_INGRESS_TOKEN=change_me
# Set to true only after the dashboard route has been switched to Caddy and a
# second tailnet device has passed the staged sign-in test.
OMNILAB_REQUIRE_IDENTITY=false

# SurfSense
DB_PASSWORD=change_me
SEARXNG_SECRET=change_me
OPENSANDBOX_API_KEY=change_me
ZERO_ADMIN_PASSWORD=change_me

# Vaultwarden
ADMIN_TOKEN=change_me

# Paperless-ngx
PAPERLESS_SECRET_KEY=change_me
PAPERLESS_DBPASSWORD=change_me

# Nextcloud
NEXTCLOUD_DBPASSWORD=change_me

# Adventurelog
POSTGRES_PASSWORD=change_me

# Puppygraph
PUPPYGRAPH_USERNAME=change_me
PUPPYGRAPH_PASSWORD=change_me

# LiteLLM
LITELLM_MASTER_KEY=change_me
FREE_LLMAPI_API_KEY=change_me

# (Add other services as needed)
