# Firecrawl self-hosted configuration
# Copy to .env and fill in as needed.

# REQUIRED: API key clients must send as `Authorization: Bearer <key>`
# Generate one: openssl rand -hex 32
TEST_API_KEY=

# --- Queue DB (nuq-postgres) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres

# --- Optional: LLM-powered /extract ---
# Point at FreeLLMAPI or Ollama on the host; blank disables extract features.
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=
# e.g. OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Optional: SearXNG search endpoint ---
SEARXNG_ENDPOINT=

# --- Optional: outbound proxy for scraping ---
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# Playwright microservice
ALLOW_LOCAL_WEBHOOKS=false
BLOCK_MEDIA=true
