# Ollama GPU configuration
# This overlay requires the NVIDIA Container Toolkit installed on the host.
# Mirrors the SurfSense CDI driver setup (driver: cdi, nvidia.com/gpu=all).
#
# Usage:
#   cd HomeServer/ollama
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml up -d
#
# Verify GPU access:
#   docker exec ollama nvidia-smi

services:
  ollama:
    deploy:
      resources:
        reservations:
          devices:
            - driver: cdi
              device_ids:
                - nvidia.com/gpu=all
              capabilities: [gpu]
