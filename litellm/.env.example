# LiteLLM — copy to litellm/.env and fill in values
# LITELLM_MASTER_KEY: protects the /v1/* admin endpoints (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=change_me
# FREE_LLMAPI_API_KEY: API key for the FreeLLMAPI gateway running on host:3001
FREE_LLMAPI_API_KEY=change_me
# LITELLM_MCP_KEY: bearer token for the /litellm_admin/mcp gateway (openssl rand -hex 32)
LITELLM_MCP_KEY=change_me
# POSTGRES_PASSWORD: password for the litellm-db postgres (generate with: openssl rand -hex 16)
POSTGRES_PASSWORD=change_me
# DATABASE_URL: litellm UI/session/model-store database (required for Admin UI login)
DATABASE_URL=postgresql://litellm:change_me@litellm-db:5432/litellm

# =============================================================================
# Paid provider API keys — only place paid keys here, NEVER in FreeLLMAPI.
# Free tiers belong in FreeLLMAPI; LiteLLM handles paid routing + spend/budgets.
# Uncomment and fill in the providers you use. Delete unused ones.
# =============================================================================

# OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...

# Anthropic (https://console.anthropic.com/settings/keys)
# ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini / Vertex AI (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=...
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/vertex-sa.json

# Mistral (https://console.mistral.ai/api-keys)
# MISTRAL_API_KEY=...

# Groq (paid tier — free tier belongs in FreeLLMAPI)
# GROQ_API_KEY=gsk-...

# xAI / Grok (https://console.x.ai)
# XAI_API_KEY=xai-...

# Together AI (https://api.together.xyz/settings/api-keys)
# TOGETHERAI_API_KEY=

# Cohere (https://dashboard.cohere.com/api-keys)
# COHERE_API_KEY=

# DeepSeek (https://platform.deepseek.com/api_keys)
# DEEPSEEK_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
# OPENROUTER_API_KEY=sk-or-...

# Fireworks AI (https://fireworks.ai/account/api-keys)
# FIREWORKS_AI_API_KEY=

# AWS Bedrock (uses IAM — set credentials via env or shared config)
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1
