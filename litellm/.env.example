# LiteLLM — copy to litellm/.env and fill in values
# LITELLM_MASTER_KEY: protects the /v1/* admin endpoints (generate with: openssl rand -hex 32)
LITELLM_MASTER_KEY=change_me
# FREE_LLMAPI_API_KEY: API key for the FreeLLMAPI gateway running on host:3001
FREE_LLMAPI_API_KEY=change_me
# POSTGRES_PASSWORD: password for the litellm-db postgres (generate with: openssl rand -hex 16)
POSTGRES_PASSWORD=change_me
# DATABASE_URL: litellm UI/session/model-store database (required for Admin UI login)
DATABASE_URL=postgresql://litellm:change_me@litellm-db:5432/litellm