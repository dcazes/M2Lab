# OpenCode Agent Environment Variables
# Copy to .env and configure with real values (which will be hidden from the container)

# Scoped Virtual Key from LiteLLM UI (routes to free-auto or local-fallback)
LITELLM_API_KEY=change_me

# Basic Auth credentials for the OpenCode Agent Web UI endpoint
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change_me

# Bearer Token shared with the host-run homelab-ctl-mcp server
CTL_MCP_TOKEN=change_me