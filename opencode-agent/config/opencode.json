{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://litellm-proxy:4000",
        "apiKey": "{env:LITELLM_API_KEY}"
      },
      "models": {
        "free-auto": { "name": "free-auto" },
        "local-fallback": { "name": "local-fallback" }
      }
    }
  },
  "model": "litellm/free-auto",
  "small_model": "litellm/local-fallback",
  "mcp": {
    "homelab-ctl": {
      "type": "remote",
      "url": "http://host.docker.internal:8790/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:CTL_MCP_TOKEN}"
      }
    }
  },
  "tools": {
    "mcp__homelab-ctl__*": false
  },
  "agent": {
    "stack-editor": {
      "tools": {
        "mcp__homelab-ctl__*": true
      }
    },
    "ops-agent": {
      "tools": {
        "mcp__homelab-ctl__*": true
      }
    }
  },
  "permission": {
    "edit": "deny",
    "bash": "deny",
    "webfetch": "deny"
  }
}