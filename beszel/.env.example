# Fill after first hub start:
# 1. Open http://localhost:8090, create admin account
# 2. Settings -> Tokens -> create a universal token -> paste as BESZEL_TOKEN
# 3. Add System with Host/IP: /beszel_socket/beszel.sock -> copy the KEY it shows into BESZEL_KEY
# 4. make stop-beszel SERVICE=beszel && make beszel
BESZEL_TOKEN=
BESZEL_KEY=
