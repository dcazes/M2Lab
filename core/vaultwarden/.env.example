# Vaultwarden requires an admin token to enable SSO. Generate one with:
#   .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=your_argon2_hash_or_hex_admin_token
SIGNUPS_ALLOWED=true

# SSO via Authentik (OpenID Connect) — see docs/setup/vaultwarden.md
# DOMAIN must be the HTTPS URL the browser reaches Vaultwarden from. It must
# match the redirect URI registered on the Authentik OIDC provider:
#   <DOMAIN>/identity/connect/oidc-signin
DOMAIN=https://127.0.0.1:19447
SSO_ENABLED=true
# Authentik OIDC provider discovery base (issuer). Vaultwarden appends
# /.well-known/openid-configuration to this.
SSO_AUTHORITY=https://127.0.0.1:19462/application/o/vaultwarden
SSO_CLIENT_ID=replace_with_authentik_client_id
SSO_CLIENT_SECRET=replace_with_authentik_client_secret
SSO_SCOPES="email profile openid offline_access"
SSO_PKCE=true
# Use the env-configured provider (not the admin-panel database provider).
SSO_USE_DB=false
