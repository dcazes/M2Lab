# Vaultwarden requires an admin token to enable SSO. Generate one with:
#   .venv/bin/python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_TOKEN=your_argon2_hash_or_hex_admin_token
SIGNUPS_ALLOWED=true

# Vaultwarden is protected by Authentik at Caddy, not by Vaultwarden's native
# organisation-SSO page. That makes opening the app an immediate redirect to
# the existing Authentik session, with no email-identification screen.
DOMAIN=https://127.0.0.1:19447
SSO_ENABLED=false
SSO_ONLY=false
