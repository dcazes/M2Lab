# Open WebUI environment configuration

# Session secret key. Generate with:
#   openssl rand -base64 32
WEBUI_SECRET_KEY=your_generated_secret_key_here

# Authentication (True enables user signup/login)
WEBUI_AUTH=True

# Display name in the UI
WEBUI_NAME=Homelab Agent

# LiteLLM gateway credential. OmniLab copies this from litellm/.env.
LITELLM_MASTER_KEY=

# OpenAI-compatible connection to LiteLLM. OmniLab writes the matching master
# key during setup so Open WebUI sees free, paid, and local routes in one place.
OPENAI_API_BASE_URL=http://host.docker.internal:4000/v1
OPENAI_API_KEY=

# Connection to local Ollama (GPU-accelerated local models)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Data persistence
# Mounted at /app/backend/data inside the container

# Native OIDC: set only after the Authentik provider and exact callback have
# been created for the installed Open WebUI release.
OPENID_PROVIDER_URL=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OPENID_REDIRECT_URI=
OAUTH_SCOPES=openid profile email groups
ENABLE_OAUTH_SIGNUP=false
