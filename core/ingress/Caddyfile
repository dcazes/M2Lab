# Authentik is served directly by Tailscale on 8462.
http://:19062 {
	reverse_proxy 127.0.0.1:9001 {
		header_up Host {$M2LAB_TAILNET_HOST}:8462
		header_up X-Forwarded-Host {$M2LAB_TAILNET_HOST}:8462
		header_up X-Forwarded-Proto https
	}
}

# Containers fetch discovery through Docker's host gateway, while Authentik
# advertises the canonical tailnet HTTPS issuer and authorization endpoints to
# browsers. The explicit bridge address is reachable only by local Docker
# workloads, not by the LAN or Tailnet.
http://:19463 {
	bind 127.0.0.1 172.17.0.1
	reverse_proxy 127.0.0.1:9001 {
		header_up Host {$M2LAB_TAILNET_HOST}:8462
		header_up X-Forwarded-Host {$M2LAB_TAILNET_HOST}:8462
		header_up X-Forwarded-Proto https
	}
}
