{
	# Tailscale terminates every browser-facing TLS connection. Caddy accepts
	# only loopback HTTP from Tailscale Serve and is never a public listener.
	auto_https off
	default_bind 127.0.0.1
	admin off
}

# Forward-auth receives the exact tailnet host and port registered in the
# corresponding Authentik proxy provider. This creates one shared SSO origin.
(authentik_gate) {
	request_header -X-Authentik-Username
	request_header -X-Authentik-Groups
	request_header -X-Authentik-Email
	request_header -X-Authentik-Uid
	forward_auth 127.0.0.1:9001 {
		uri /outpost.goauthentik.io/auth/caddy
		header_up Host {$M2LAB_TAILNET_HOST}:{args[0]}
		header_up X-Forwarded-Host {$M2LAB_TAILNET_HOST}:{args[0]}
		header_up X-Forwarded-Proto https
		header_down Location http://127.0.0.1:9001 https://{$M2LAB_TAILNET_HOST}:8462
		copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Uid
	}
}

(authentik_outpost) {
	reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001 {
		header_up Host {$M2LAB_TAILNET_HOST}:{args[0]}
		header_up X-Forwarded-Host {$M2LAB_TAILNET_HOST}:{args[0]}
		header_up X-Forwarded-Proto https
	}
}

(tailnet_headers) {
	header_up Host {$M2LAB_TAILNET_HOST}:{args[0]}
	header_up X-Forwarded-Host {$M2LAB_TAILNET_HOST}:{args[0]}
	header_up X-Forwarded-Proto https
}

(dashboard_headers) {
	header_up X-OmniLab-Ingress {$OMNILAB_INGRESS_TOKEN}
}

# Dashboard access remains loopback-only; application routes below are
# published individually through Tailscale Serve after foundation preflight.
http://:19460 {
	reverse_proxy 127.0.0.1:8787 {
		import dashboard_headers
	}
}

http://:19444 {
	import authentik_outpost 8444
	import authentik_gate 8444
	@bridge path /m2lab-sso/start
	handle @bridge {
		rewrite * /api/identity/bridge/surfsense
		reverse_proxy 127.0.0.1:8787 {
			import dashboard_headers
		}
	}
	respond /auth/register 404
	@entry path / /login
	redir @entry /m2lab-sso/start 302
	handle {
		reverse_proxy 127.0.0.1:3929 {
			import tailnet_headers 8444
		}
	}
}

http://:19445 {
	import authentik_outpost 8445
	import authentik_gate 8445
	@litellm_root path /
	redir @litellm_root /ui/ 302
	@owners header X-Authentik-Groups *omnilab-owners*
	handle @owners {
		reverse_proxy 127.0.0.1:4000 {
			import tailnet_headers 8445
		}
	}
	respond "M2Lab owner access required" 403
}

http://:19458 {
	# Firecrawl has no interactive account/session to provision. It remains
	# reachable only through its private Tailnet route and enforces its own API
	# bearer key for requests.
	reverse_proxy 127.0.0.1:3002 {
		import tailnet_headers 8458
	}
}

# Ollama is a private, machine-facing API. It deliberately has no browser
# launch link or Authentik session; callers reach it over the Tailnet API route.
http://:19457 {
	reverse_proxy 127.0.0.1:11434 {
		import tailnet_headers 8457
	}
}

http://:19459 {
	import authentik_outpost 8459
	import authentik_gate 8459
	@owners header X-Authentik-Groups *omnilab-owners*
	handle @owners {
		reverse_proxy 127.0.0.1:3001 {
			import tailnet_headers 8459
		}
	}
	respond "M2Lab owner access required" 403
}

