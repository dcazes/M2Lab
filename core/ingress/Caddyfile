{
  auto_https off
  admin off
}

# Caddy listens only on loopback high ports. Tailscale Serve remains the sole
# external TLS endpoint and is switched per app only after verification.
(authentik_gate) {
  request_header -X-Authentik-Username
  request_header -X-Authentik-Groups
  request_header -X-Authentik-Email
  request_header -X-Authentik-Uid
  forward_auth 127.0.0.1:9001 {
    uri /outpost.goauthentik.io/auth/caddy
    # The embedded outpost is reached over loopback, but it must see the
    # public Authentik host to generate a usable authorization redirect.
    header_up Host home.taile2cc7a.ts.net:8462
    copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Uid
  }
}

# Forward the proxy-outpost endpoints without applying the gate itself. These
# endpoints complete Authentik's redirect, session, and sign-out flows.
(authentik_outpost) {
  reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001 {
    header_up Host home.taile2cc7a.ts.net:8462
  }
}

(dashboard_headers) {
  header_up X-OmniLab-Ingress {$OMNILAB_INGRESS_TOKEN}
}

:19460 {
  import authentik_outpost
  import authentik_gate
  @owners header X-Authentik-Groups *omnilab-owners*
  handle @owners {
    reverse_proxy 127.0.0.1:8787 {
      import dashboard_headers
    }
  }
  respond "OmniLab owner access required" 403
}

