{
  # auto-HTTPS only for sites that explicitly request TLS via https:// + a
  # local_certs (internal CA) cert; existing bare :PORT sites stay plain HTTP.
  auto_https disable_redirects
  local_certs
  admin off
}

# Caddy listens only on loopback high ports. Tailscale Serve remains the sole
# external TLS endpoint and is switched per app only after verification.
(authentik_gate) {
  request_header -X-Authentik-Username
  request_header -X-Authentik-Groups
  request_header -X-Authentik-Email
  request_header -X-Authentik-Uid
  forward_auth 127.0.0.1:9001 {
    uri /outpost.goauthentik.io/auth/caddy
    # The embedded outpost is reached over loopback, but it must see the
    # public Authentik host to generate a usable authorization redirect.
    header_up Host home.taile2cc7a.ts.net:8462
    copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Uid
  }
}

# Forward the proxy-outpost endpoints without applying the gate itself. These
# endpoints complete Authentik's redirect, session, and sign-out flows.
(authentik_outpost) {
  reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001 {
    header_up Host home.taile2cc7a.ts.net:8462
  }
}

# Machine-local variant of the Authentik forward-auth integration.  Keeping
# the public host explicit is important: Authentik session cookies are scoped
# to this HTTPS origin, so all local SSO applications share one session.
(authentik_local_gate) {
  request_header -X-Authentik-Username
  request_header -X-Authentik-Groups
  request_header -X-Authentik-Email
  request_header -X-Authentik-Uid
  forward_auth 127.0.0.1:9001 {
    uri /outpost.goauthentik.io/auth/caddy
    header_up Host 127.0.0.1:19462
    header_up X-Forwarded-Proto https
    header_up X-Forwarded-Host 127.0.0.1:19447
    # The embedded outpost reaches Authentik on its loopback listener. Send
    # browser redirects back through the canonical HTTPS SSO origin so the
    # Authentik session is reused by every protected local app.
    header_down Location http://127.0.0.1:9001 https://127.0.0.1:19462
    copy_headers X-Authentik-Username X-Authentik-Groups X-Authentik-Email X-Authentik-Uid
  }
}

(authentik_local_outpost) {
  reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:9001 {
    header_up Host 127.0.0.1:19462
    header_up X-Forwarded-Proto https
  }
}

