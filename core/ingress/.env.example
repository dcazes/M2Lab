# Same random value as OMNILAB_INGRESS_TOKEN in the root .env. It authenticates
# the local Caddy-to-dashboard hop; it is not an end-user credential.
OMNILAB_INGRESS_TOKEN=replace_with_openssl_rand_hex_32
# Hostname from services.yaml → settings.tailnet_base, without https://.
M2LAB_TAILNET_HOST=replace_with_your_tailnet_hostname
