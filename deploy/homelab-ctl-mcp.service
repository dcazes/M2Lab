[Unit]
Description=OmniLab control-plane MCP (read/manage verbs for agents)
After=docker.service network-online.target

[Service]
WorkingDirectory=@OMNILAB_ROOT@
ExecStart=@OMNILAB_ROOT@/.venv/bin/python -m ctl.mcp_server
Restart=on-failure
RestartSec=3
EnvironmentFile=-@OMNILAB_ROOT@/.env

[Install]
WantedBy=default.target
