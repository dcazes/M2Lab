[Unit]
Description=Homelab control-plane dashboard
After=docker.service network-online.target

[Service]
WorkingDirectory=%h/Desktop/Programs/HomeServer
ExecStart=%h/Desktop/Programs/HomeServer/.venv/bin/python -m ctl.app
Restart=on-failure
RestartSec=3
EnvironmentFile=-%h/Desktop/Programs/HomeServer/.env

[Install]
WantedBy=default.target