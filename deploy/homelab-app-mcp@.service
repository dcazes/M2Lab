[Unit]
Description=M2Lab isolated MCP adapter for %i
After=network-online.target docker.service

[Service]
WorkingDirectory=@OMNILAB_ROOT@
ExecStart=@OMNILAB_ROOT@/.venv/bin/python -m ctl.app_mcp %i
Restart=on-failure
RestartSec=3
EnvironmentFile=-@OMNILAB_ROOT@/.env

[Install]
WantedBy=default.target
